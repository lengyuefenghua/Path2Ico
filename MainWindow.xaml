<Window x:Class="Path2Ico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Path2Ico - Path 转 PNG / JPG / ICO"
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile"
                      Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE4E4E4">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="路径数据（SVG d / WPF Path mini-language）、SVG 或 XAML 矢量片段"
                       Margin="0,0,0,4" FontWeight="Bold" />
            <TextBox Grid.Row="1" x:Name="PathTextBox"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="13"
                     TextChanged="OnTextChanged" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="示例" Width="70" Height="26" Click="OnSampleClick" />
                <Button Content="清空" Width="70" Height="26" Margin="8,0,0,0" Click="OnClearClick" />
            </StackPanel>

            <GroupBox Grid.Row="3" Header="样式" Margin="0,10,0,0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="FillEnabledCheckBox"
                              Content="填充色" IsChecked="True" VerticalAlignment="Center"
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="FillColorTextBox" Text="#FF2196F3"
                             Margin="8,4,8,4" TextChanged="OnTextChanged" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="留白比例" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="PaddingTextBox" Text="0.1"
                             Width="60" Margin="8,4,0,4" TextChanged="OnTextChanged" />

                    <CheckBox Grid.Row="1" Grid.Column="0" x:Name="StrokeEnabledCheckBox"
                              Content="描边色" VerticalAlignment="Center"
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="StrokeColorTextBox" Text="#FF000000"
                             Margin="8,4,8,4" TextChanged="OnTextChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="描边宽度" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="StrokeThicknessTextBox" Text="2"
                             Width="60" Margin="8,4,0,4" TextChanged="OnTextChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="颜色支持 #RRGGBB / #AARRGGBB，也可填颜色名（如 Red）"
                               Foreground="#FF777777" FontSize="11" Margin="0,6,0,0" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="256" Height="256"
                    BorderBrush="#FF999999" BorderThickness="1"
                    Background="{StaticResource CheckerBrush}">
                <Image x:Name="PreviewImage" Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <GroupBox Grid.Row="1" Header="输出尺寸（PNG / JPG）" Margin="0,10,0,0" Padding="8">
                <ComboBox x:Name="OutputSizeComboBox" SelectedIndex="9"
                          HorizontalAlignment="Left" Width="120">
                    <ComboBoxItem Content="16" Tag="16" />
                    <ComboBoxItem Content="20" Tag="20" />
                    <ComboBoxItem Content="24" Tag="24" />
                    <ComboBoxItem Content="32" Tag="32" />
                    <ComboBoxItem Content="40" Tag="40" />
                    <ComboBoxItem Content="48" Tag="48" />
                    <ComboBoxItem Content="64" Tag="64" />
                    <ComboBoxItem Content="96" Tag="96" />
                    <ComboBoxItem Content="128" Tag="128" />
                    <ComboBoxItem Content="256" Tag="256" />
                </ComboBox>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="ICO 内嵌尺寸" Margin="0,10,0,0" Padding="8">
                <WrapPanel>
                    <CheckBox x:Name="Ico16" Content="16" Tag="16" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico20" Content="20" Tag="20" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico24" Content="24" Tag="24" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico32" Content="32" Tag="32" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico40" Content="40" Tag="40" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico48" Content="48" Tag="48" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico64" Content="64" Tag="64" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico96" Content="96" Tag="96" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico128" Content="128" Tag="128" IsChecked="True" Margin="0,2,12,2" />
                    <CheckBox x:Name="Ico256" Content="256" Tag="256" IsChecked="True" Margin="0,2,12,2" />
                </WrapPanel>
            </GroupBox>

            <Button Grid.Row="3" Content="生成并保存" Height="36" Margin="0,12,0,0"
                    FontWeight="Bold" Click="OnSaveClick" />

            <GroupBox Grid.Row="4" Header="日志" Margin="0,10,0,0" Padding="6">
                <TextBox x:Name="LogTextBox" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"
                         Background="#FFF6F6F6" BorderThickness="0" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
